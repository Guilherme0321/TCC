ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Modelo dev gratuito (--model dev-free): endpoint compatível com OpenAI.
# Valores abaixo: llama 3.2 via Docker Model Runner (habilitar uma vez com
# `docker desktop enable model-runner --tcp=12434`).
# Padrões sem essas variáveis: Ollama local (http://localhost:11434/v1).
DEV_LLM_BASE_URL=http://localhost:12434/engines/v1
DEV_LLM_MODEL=ai/llama3.2:latest
DEV_LLM_API_KEY=docker
